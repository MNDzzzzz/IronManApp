# ==========================================
# CONFIGURACIÓN DE IRONMANAPP (100% GRATUITO)
# ==========================================

# 1. Supabase (Base de datos PostgreSQL gratuita)
# Obtén estos valores en https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_secreta

# 2. Token de Autenticación para Puente Android (Health Connect)
# Define cualquier frase secreta aquí y colócala en tu app de Android
BRIDGE_API_KEY=ironman_secret_fit3_token_2026

# 3. Strava API & Webhooks
# Obtén estos valores en https://www.strava.com/settings/api
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=tu_strava_client_secret
STRAVA_VERIFY_TOKEN=ironman_strava_webhook_token_secure
STRAVA_ACCESS_TOKEN=tu_strava_access_token
STRAVA_REFRESH_TOKEN=tu_strava_refresh_token

# 4. Telegram Bot & Nutrición con IA
# Bot creado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_bot_father
# Clave gratuita de Google Gemini en https://aistudio.google.com
GEMINI_API_KEY=tu_clave_gratuita_de_gemini

# 5. Seguridad de Acceso Personal a la WebApp (PIN)
APP_MASTER_PIN=1234
SESSION_SECRET=clave_secreta_super_segura_para_firmar_cookies_32_chars
